# NEARvest game server settings: variable names only, no values. Copy to .env (or run:
# node scripts/init-env.ts, which fills in fresh secrets) and set the values there.
# An empty value uses the server's safe default (fake chain, dev login off, port 8787).
# Never commit .env.

# e.g. PORT=8787
PORT=
# "near" = real NEAR testnet (this Mac and the game server), "fake" = everything local (default)
# e.g. CHAIN_MODE=near
CHAIN_MODE=
# e.g. NEAR_NETWORK=testnet
NEAR_NETWORK=
# e.g. NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_RPC_URL=
# e.g. EXPLORER_TX_URL=https://testnet.nearblocks.io/txns/
EXPLORER_TX_URL=

# Player account factory (deployed on the main account) and contracts
# e.g. FACTORY_ACCOUNT_ID=nearvest.testnet
FACTORY_ACCOUNT_ID=
# e.g. PANEN_CONTRACT_ID=panen.nearvest.testnet
PANEN_CONTRACT_ID=
# e.g. POHON_CONTRACT_ID=pohon.nearvest.testnet
POHON_CONTRACT_ID=

# Game server account: minter, relayer (pays gas) and player creator
# e.g. GAME_ACCOUNT_ID=game.nearvest.testnet
GAME_ACCOUNT_ID=
GAME_PRIVATE_KEY=
# NEAR sent to each new player account to pay its storage
# e.g. PLAYER_ACCOUNT_DEPOSIT_NEAR=0.003
PLAYER_ACCOUNT_DEPOSIT_NEAR=

# 32 random bytes, base64. Encrypts player keys in the database. Losing it = losing player keys.
MASTER_KEY=
# e.g. DATABASE_PATH=./data/nearvest.sqlite
DATABASE_PATH=

# Google login (OAuth Client ID of type "Web application"; no secret needed)
GOOGLE_CLIENT_ID=
# Username-only login for local testing. Set false on a public server. It is also
# switched off automatically when WEB_ORIGINS contains any non-localhost site.
# e.g. DEV_LOGIN=true (this Mac only)
DEV_LOGIN=
# New players start in demo mode (1 game day = 1 minute)
# e.g. DEMO_MODE_DEFAULT=false
DEMO_MODE_DEFAULT=

# Web game origins allowed to call this server (comma separated)
# e.g. WEB_ORIGINS=http://localhost:5173
WEB_ORIGINS=

# TaniBot's brain. on = NEAR AI Cloud (uses the $10 credits), off = simple rules only.
# Keep off for development and tests.
# e.g. TANIBOT_AI=off
TANIBOT_AI=
# NEAR AI Cloud API key (cloud.near.ai). Only needed when TANIBOT_AI=on.
NEAR_AI_API_KEY=
# Model on NEAR AI Cloud (cheap, verifiable).
# e.g. TANIBOT_AI_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
TANIBOT_AI_MODEL=
# Most AI calls per UTC day for the whole game (30 while developing).
# e.g. TANIBOT_AI_MAX_CALLS_PER_DAY=30
TANIBOT_AI_MAX_CALLS_PER_DAY=
# Dollar brake: AI stops for good once the estimated total cost reaches this (credits are $10).
# e.g. TANIBOT_AI_BUDGET_USD=8
TANIBOT_AI_BUDGET_USD=
# Arena: the online duel against a real player (invite, live turns). on / off; empty = off.
# Off = the Duel button only fights the other garden's TaniBot (Arena v2).
# e.g. ARENA_ONLINE=off
ARENA_ONLINE=
