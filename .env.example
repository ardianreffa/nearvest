# Copy this file to .env and fill in the values. Never commit .env.

# NEAR (testnet only)
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_MASTER_ACCOUNT=nearvest.testnet
# Private key of the relayer account. Keep it only in .env on the server.
NEAR_RELAYER_PRIVATE_KEY=

# Contract accounts (filled in after testnet deploy)
PANEN_CONTRACT_ID=
TREE_NFT_CONTRACT_ID=
FARMER_CARD_CONTRACT_ID=
GARDEN_CONTRACT_ID=

# Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=

# NEAR AI Cloud (TaniBot and Mr. Darto)
NEAR_AI_API_KEY=
NEAR_AI_MODEL=

# Game
DEMO_MODE=false
DAY_ROLLOVER_HOUR_WIB=7
