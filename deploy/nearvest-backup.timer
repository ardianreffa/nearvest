# Every day at 03:30 VPS time (Asia/Jakarta), away from other scheduled jobs on the VPS.
# Persistent: a backup missed while the VPS was off runs at the next start.

[Unit]
Description=Daily NEARvest database backup

[Timer]
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
