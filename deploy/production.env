# NEARvest server settings for the VPS that are NOT secret (committed on purpose).
# systemd reads this AFTER /etc/nearvest/server.env (the secrets copied from the Mac), so these
# values win. Never put a key or password in this file.

NODE_ENV=production
CHAIN_MODE=near
PORT=8787
DATABASE_PATH=/var/lib/nearvest/nearvest.sqlite
# Never on a public server (the server also switches it off by itself for public origins).
DEV_LOGIN=false
# The Vercel address of the web game (comma separated, no trailing slash). Fill in at step 9
# of docs/DEPLOY.md. Empty = only http://localhost:5173 may call the server.
WEB_ORIGINS=
# TaniBot's AI brain for the hosted demo, with its safety limits.
TANIBOT_AI=on
TANIBOT_AI_MAX_CALLS_PER_DAY=1500
TANIBOT_AI_BUDGET_USD=8
