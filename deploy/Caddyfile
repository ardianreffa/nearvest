# NEARvest: HTTPS for the game server (docs/DEPLOY.md). Certificates come from Let's Encrypt
# automatically (port 80 and 443 must be open in the cloud provider's security group).
{
	# No admin API on port 2019: changes need a restart of nearvest-caddy.
	admin off
}

150-109-24-35.sslip.io {
	encode zstd gzip

	# The game server limits free gifts per IP using the LAST X-Forwarded-For entry
	# (server/src/client-ip.ts). Caddy writes X-Forwarded-For itself (without trusted_proxies
	# it ignores a visitor's own copy). CF-Connecting-IP is ignored by the server unless
	# TRUST_CF_IP=on; a faked one from a visitor is also removed here.
	request_header -CF-Connecting-IP

	reverse_proxy 127.0.0.1:8787

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
}
